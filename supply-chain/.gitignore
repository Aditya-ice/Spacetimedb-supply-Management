#Generated by Cargo
#Ignore compiled files and executables.
/target/

#It is recommended to commit Cargo.lock in team projects
#to ensure everyone has the same dependency versions.
#Cargo.lock
#SpacetimeDB specific ignores
#This folder can contain cached data.
/.spacetime

#This file contains sensitive credentials and should never be committed.
.identity

#Ignore backup files generated by rustfmt
**/*.rs.bk

#Ignore JetBrains IDE files
.idea/

#Ignore VSCode IDE files
.vscode/